# Serveur web du VPS ADTF (Caddy) : HTTPS automatique (Let's Encrypt).
# Ce fichier est relu automatiquement quand il change sur la branche déployée.
{
	# Certificat obtenu à la première connexion sur le VPS : pas de coupure
	# au moment où un domaine est basculé vers le VPS dans les DNS.
	on_demand_tls {
		ask http://localhost:5555/autorise
	}
}

# Liste des domaines autorisés à recevoir un certificat (interne au conteneur).
http://localhost:5555 {
	@autorise query domain=adtfermeture.fr domain=www.adtfermeture.fr domain=vps.adtfermeture.fr domain=devis-adtf.fr domain=www.devis-adtf.fr domain=vps.devis-adtf.fr
	respond @autorise 200
	respond 404
}

(securite) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Application monopage (Vite/React) :
# - fichiers versionnés de /assets : cache long ;
# - images : cache d'un jour ;
# - index.html et toutes les routes de l'application : jamais en cache,
#   pour que chaque mise à jour soit vue immédiatement.
(spa) {
	import securite

	@versionnes path /assets/*
	header @versionnes Cache-Control "public, max-age=31536000, immutable"

	@images path *.png *.jpg *.jpeg *.webp *.svg *.ico *.gif
	header @images Cache-Control "public, max-age=86400"

	@pages not path /assets/* *.png *.jpg *.jpeg *.webp *.svg *.ico *.gif *.woff *.woff2
	header @pages Cache-Control "no-cache, no-store, must-revalidate"

	# Un fichier de /assets absent doit renvoyer 404, pas la page d'accueil.
	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server {
			hide .htaccess _redirects README.md
		}
	}
}

# vps.* : adresses de test, toujours dirigées vers le VPS.
adtfermeture.fr, www.adtfermeture.fr, vps.adtfermeture.fr {
	tls {
		on_demand
	}
	root * /srv/current/sites/adtfermeture.fr
	import spa
}

devis-adtf.fr, www.devis-adtf.fr, vps.devis-adtf.fr {
	tls {
		on_demand
	}
	root * /srv/current/sites/devis-adtf.fr
	import spa
}
